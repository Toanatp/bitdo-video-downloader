{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bitdo Downloader",
  "version": "1.0.2",
  "identifier": "com.shopbitdo.downloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:15688",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bitdo Downloader",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Bitdo Downloader"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../browser-extension": "browser-extension"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "bitdo-downloader"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Toanatp/bitdo-video-downloader/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2QTc3MUJCNEEyQTFFRjIKUldUeUhpcEt1M0duTm5FajZ3K0d1OWFqSWpjNmI4RDVyaUJpZzRxaGxTc2JkalIyYTFUdm9jc3gK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
